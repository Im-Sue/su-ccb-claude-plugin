{
  "schema_version": "classifier-corpus-v0.1",
  "description": "Basic L1/L2-A/L2-B/L2-C corpus for collaboration classifier. Later L2 analyzers may reuse these cases as stable fixtures.",
  "cases": [
    {
      "id": "l1_create_table_additive",
      "description": "CREATE TABLE is additive at L1.",
      "diff_lines": [
        "diff --git a/sql/topic.sql b/sql/topic.sql",
        "new file mode 100644",
        "index 0000000..1111111",
        "--- /dev/null",
        "+++ b/sql/topic.sql",
        "@@ -0,0 +1,6 @@",
        "+CREATE TABLE market_topic (",
        "+  id bigint NOT NULL,",
        "+  name varchar(64) NULL",
        "+);"
      ],
      "expected": {
        "classifier_coverage": "full",
        "minimum_tier": "lite",
        "surface": { "type": "table", "change": "additive", "floor": "lite", "source": "l1.sql.create_table" }
      }
    },
    {
      "id": "l1_alter_add_nullable_additive",
      "description": "ALTER ADD nullable column is additive at L1.",
      "diff_lines": [
        "diff --git a/sql/topic.sql b/sql/topic.sql",
        "index 1111111..2222222 100644",
        "--- a/sql/topic.sql",
        "+++ b/sql/topic.sql",
        "@@ -1,2 +1,3 @@",
        "+ALTER TABLE market_topic ADD COLUMN display_name varchar(64) NULL;"
      ],
      "expected": {
        "classifier_coverage": "full",
        "minimum_tier": "lite",
        "surface": { "type": "table", "change": "additive", "floor": "lite", "source": "l1.sql.alter_add_nullable" }
      }
    },
    {
