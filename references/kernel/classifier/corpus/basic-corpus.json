    {
      "id": "l2_mybatis_write_statement",
      "description": "MyBatis XML write statement touching a sink table is full risk.",
      "diff_lines": [
        "diff --git a/src/main/resources/mapper/PointMapper.xml b/src/main/resources/mapper/PointMapper.xml",
        "index 1111111..2222222 100644",
        "--- a/src/main/resources/mapper/PointMapper.xml",
        "+++ b/src/main/resources/mapper/PointMapper.xml",
        "@@ -1,3 +1,5 @@",
        "+<update id=\"addPoint\">",
        "+  UPDATE point_account SET balance = balance + #{amount}",
        "+</update>"
      ],
      "expected": {
        "classifier_coverage": "full",
        "minimum_tier": "full",
        "surface": { "type": "money_sink", "change": "sink_mapper_write", "floor": "full", "source": "l2.sink.mapper_write" }
      }
    },
